#define PI 3.14159265359f

struct StarData
{
    float3 Position;
    float Euv;
    float Optical;
};

// Texture
Texture2D<float2> _VelocityRead;
Texture2D<float2> _GradientRead;
RWTexture2D<float2> _GradientWrite;
Texture2D<float2> _CloudRead;
RWTexture2D<float2> _CloudWrite;
Texture2D<float> _VeilRead;
RWTexture2D<float> _VeilWrite;
Texture2DArray<float2> _ShadowMapRead;
RWTexture2DArray<float2> _ShadowMapWrite;
Texture2D<float> _FluxRead;
RWTexture2D<float> _FluxWrite;
Texture2D<float4> _ReflectionRead;
RWTexture2D<float4> _ReflectionWrite;
Texture2D<float4> _FishRead; // 魚（雲の手前、Veil の後ろ）を別カメラで描いた絵。A = 魚がある所
Texture2D<float4> _VeilLightRead;
RWTexture2D<float4> _VeilLightWrite;
Texture2D<float4> _StarFieldRead;
RWTexture2D<float4> _StarFieldWrite;
Texture2D<float4> _NebulaRead;
RWTexture2D<float4> _NebulaWrite;

// Buffer
StructuredBuffer<StarData> _StarRead;
RWStructuredBuffer<StarData> _StarWrite;

// Common
float _ViewerHeight;          // 観測者の高さ
float _FlowReferenceDistance; // 観測者からの距離がこの値の面で、DepthSpeed が 1 になる
int2 _Resolution;
int _StarFieldCount; // 焼き込む星の数
float _DeltaTime;
float _Aspect;

// InitializeCloud

// AdvectCloud
SamplerState linearRepeatSampler;
SamplerState linear_repeatU_clampV_sampler;

// SweepHorizon
int _AngleCount;
float _AngleStep;
int _StarCount;
int _RadiusCount;
float _MaxRadius;
float _RadiusStep;
float _MinN;
float _BowlDepth; // お椀で、光源から最も遠い点（r = _MaxRadius）が上がる量
float _HDiffMin; // slope の分母（光源の高さ - 面の高さ）の下限

// IlluminateCloud
float _MinDist;
float _ShadowFill;
float4 _S2Color;
float _ReflectionScale; // 反射光の明るさの倍率
float _HgG;             // 位相関数の g（前へ散る偏り）
float _NReflect;        // 反射が頭打ちになる密度の目安
float3 _OpticalExtinction; // dustPath に掛ける RGB の係数（青ほど大きい）
float4 _StarlightColor; // 星の光の色（白青）

// Compose
float4 _HaColor;
float _S2Thickness;
float _HaThickness;
float _S2Weight;
float _HaWeight;
int _LayerSampleCount;
float _LayerThkCutoffRatio;
float _NRef;
float _LimbGainMax;
float _FogScale;
float _FogLodStart;
int _FogLevels;
float _FogFalloff;
float4 _O3Color;
float _O3Weight;
float _LogUMin;
float _LogUMax;

// Veil（手前の塵）。InitializeVeil・IlluminateVeil・Compose が使う
int _VeilNoiseCellsY;       // 一番粗いオクターブの縦の格子数
uint _VeilSeed;
int _VeilOctaves;
float _VeilWarp;            // ノイズの位置を歪める量（uv）。大きいほど渦巻く
float _VeilCutoff;          // これより低いノイズの所は塵なし
float _VeilScale;           // 密度の倍率
float _VeilHeight;          // 塵の高さ（光源より大きい）
float3 _VeilExtinction;     // 吸収の RGB の係数（青ほど大きい）
float _VeilFloor;           // 画面全体に薄く広がる塵の量
float _VeilGlowScale;       // 散乱光の明るさの倍率
float _VeilScatterN;        // 散乱が頭打ちになる密度の目安
float _VeilLightLength;     // 塵が自分の影を落とす距離（光源の方へ読む長さ）
int _VeilLightTaps;         // その距離を読む点の数
float _VeilLightExtinction; // 光源の方の塵の量に掛ける係数

// DebugView
// 0 は Final（Compose の結果をそのまま見る）。この場合 DebugView は Dispatch しない
// 値は Nebula.cs の enum DebugMode と同じ並びにする
#define DEBUG_HEIGHT 1
#define DEBUG_DENSITY 2
#define DEBUG_NORMAL 3
#define DEBUG_FLUX 4
#define DEBUG_LAYERS 5
#define DEBUG_FOGFLUX 6
#define DEBUG_IONIZATION 7
#define DEBUG_DUST_PATH 8
#define DEBUG_REFLECTION 9
#define DEBUG_VEIL 10
#define DEBUG_VEIL_LIGHT 11
int _DebugMode;
float2 _DebugRange;

uint2 modIndex(int2 index)
{
    int2 res = _Resolution;
    return (uint2)((index % res + res) % res);
}

// 高さ h の面の、流れの速さの係数。観測者に近い（手前の）面ほど速く、遠い面ほど遅い（遠近法の視差）
float DepthSpeed(float h)
{
    // 観測者からの距離は、0 以下にならないよう下限で切る
    return _FlowReferenceDistance / max(_ViewerHeight - h, 0.01);
}

// 点と光源の差 (x, y)（V座標系）を、画面の端でつなげた最短の向きに直す
float2 WrapDelta(float2 delta)
{
    return float2(delta.x - _Aspect * round(delta.x / _Aspect),
                  delta.y - round(delta.y));
}

// お椀で上がる高さ。r は、光源からの最短距離（V座標系の長さ）
float BowlRise(float r)
{
    float t = r / _MaxRadius;
    return _BowlDepth * t * t;
}

// 高さの勾配 (gx, gy)。画面の高さ 1 あたり、高さ h がどれだけ増えるか（お椀なし）
float2 HeightGradient(uint2 id)
{
    int2 p = id;

    // 上下左右の隣のテクセルの高さ（画面の端は反対側につなげて読む）
    float hRight = _CloudRead[modIndex(p + int2(1, 0))].x;
    float hLeft  = _CloudRead[modIndex(p + int2(-1, 0))].x;
    float hUp    = _CloudRead[modIndex(p + int2(0, 1))].x;
    float hDown  = _CloudRead[modIndex(p + int2(0, -1))].x;

    // 勾配: 画面の高さ 1 あたり、高さ h がどれだけ増えるか
    // 2 テクセル離れた点の差を、2 / _Resolution.y で割る = 差 * _Resolution.y / 2
    float gx = (hRight - hLeft) * _Resolution.y * 0.5;
    float gy = (hUp - hDown) * _Resolution.y * 0.5;

    return float2(gx, gy);
}

// 勾配から法線（長さ 1）を作る。高さが右へ増える面 (gx > 0) は、法線が左へ傾く
float3 NormalFromGradient(float2 gradient)
{
    return normalize(float3(-gradient.x, -gradient.y, 1));
}

// 面の法線（お椀なし）。x, y, z = N.x, N.y, N.h（z が観測者の側）
float3 SurfaceNormal(uint2 id)
{
    return NormalFromGradient(HeightGradient(id));
}

// 密度 n が濃いほど薄くなる層の厚さ
float LayerThickness(float baseThickness, float n)
{
    return baseThickness * _NRef / n;
}

// 電離面のまわりの層 1 枚分の明るさ（周縁増光はまだ掛けない）
// uv: 今のピクセル / normalXY: 法線の x, y / thickness: 層の厚さ（画面の高さが 1）
float3 LayerGlow(float2 uv, float2 normalXY, float thickness, float3 color, float weight)
{
    float sum = 0;
    for (int i = 0; i < _LayerSampleCount; i++)
    {
        // t: 層の範囲（厚さ * _LayerThkCutoffRatio）のうち、どこまで進んだか (0〜1)
        float t = (i + 0.5) / _LayerSampleCount;

        // 電離面から離れた距離 d
        float d = t * _LayerThkCutoffRatio * thickness;

        // 距離 d の層は、画面上で法線の向きに d だけずれて見える。
        // だから、d だけ逆向きにずらした所の電離面に届いた光 (flux) を読む。
        // u は横の目盛りが aspect 倍に伸びているので、x だけ aspect で割る
        float2 shift = float2(normalXY.x / _Aspect, normalXY.y) * d;
        float flux = _FluxRead.SampleLevel(linearRepeatSampler, uv - shift, 0);

        // 離れるほど暗い: exp(-d / thickness) = exp(-t * _LayerThkCutoffRatio)
        sum += exp(-t * _LayerThkCutoffRatio) * flux;
    }

    // 点の間隔 / 厚さ = _LayerThkCutoffRatio / _LayerSampleCount を掛けて、足し合わせを積分の近似にする
    sum *= _LayerThkCutoffRatio / _LayerSampleCount;
    return color * weight * sum;
}

// s2 と ha の層を足し、周縁増光を掛けたもの。面なしは 0
float3 Layers(uint2 id)
{
    float n = _CloudRead[id].y;
    if (!(n >= _MinN)) return 0;

    float2 uv = (id + 0.5) / float2(_Resolution);
    float3 normal = SurfaceNormal(id);

    // 壁を真横から見るほど (N.h が小さいほど) 明るい線になる
    float limb = min(1.0 / normal.z, _LimbGainMax);

    float3 s2 = LayerGlow(uv, normal.xy, LayerThickness(_S2Thickness, n), _S2Color.rgb, _S2Weight);
    float3 ha = LayerGlow(uv, normal.xy, LayerThickness(_HaThickness, n), _HaColor.rgb, _HaWeight);
    return (s2 + ha) * limb;
}

// 霧に使う flux: 粗さの違うミップレベルを重ねて、まわりへにじませた flux
// lod = _FogLodStart, +1, +2, ... を _FogLevels 枚。粗いほど重みを _FogFalloff 倍ずつ弱める
float FogFlux(float2 uv)
{
    float sum = 0;
    float weightSum = 0;
    float weight = 1;
    for (int i = 0; i < _FogLevels; i++)
    {
        sum += weight * _FluxRead.SampleLevel(linearRepeatSampler, uv, _FogLodStart + i);
        weightSum += weight;
        weight *= _FogFalloff;
    }
    // 重みの合計が 1 になるように割る（枚数を変えても霧全体の明るさが変わらない）
    return sum / weightSum;
}

// 電離パラメータ U: ガス 1 粒あたりに届く光の多さ。面なし (n が _MinN 未満) は n = _MinN として扱う
float IonizationParameter(float fogFlux, float n)
{
    return fogFlux / max(n, _MinN);
}

// [O III] の青緑。U が大きい (光が強く密度が低い) 所でだけ出る
float3 OIII(float fogFlux, float n)
{
    float u = IonizationParameter(fogFlux, n);
    // log10(U) が logUMin のとき 0、logUMax のとき 1
    float t = saturate((log10(max(u, 1e-6)) - _LogUMin) / (_LogUMax - _LogUMin));
    return _O3Color.rgb * _O3Weight * t * fogFlux;
}

uint pcg(uint v)
{
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// 画面の端でつながる勾配ノイズ（Perlin ノイズ）。格子点の番号を格子の数 period で割った余りにしてから、ランダムな向きを決める
float2 LatticeGradient(int2 cell, int2 period, uint seed)
{
    cell = ((cell % period) + period) % period;
    float angle = pcg((uint)cell.x + pcg((uint)cell.y + seed)) / 4294967295.0 * 2 * PI;
    return float2(cos(angle), sin(angle));
}

// p は格子の単位の位置。戻り値はおよそ -0.7〜0.7
float GradientNoise(float2 p, int2 period, uint seed)
{
    int2 i = (int2)floor(p);
    float2 f = frac(p);

    float n00 = dot(LatticeGradient(i, period, seed), f);
    float n10 = dot(LatticeGradient(i + int2(1, 0), period, seed), f - float2(1, 0));
    float n01 = dot(LatticeGradient(i + int2(0, 1), period, seed), f - float2(0, 1));
    float n11 = dot(LatticeGradient(i + int2(1, 1), period, seed), f - float2(1, 1));

    float2 s = f * f * f * (f * (f * 6 - 15) + 10);
    return lerp(lerp(n00, n10, s.x), lerp(n01, n11, s.x), s.y);
}

// fBm: オクターブ o ごとに格子の数を 2^o 倍、重みを 0.5^o 倍にして足す。戻り値は 0〜1
float VeilFbm(float2 uv, uint seed)
{
    int2 baseCells = int2(round(_VeilNoiseCellsY * _Aspect), _VeilNoiseCellsY);
    float sum = 0;
    float weightSum = 0;
    float weight = 1;
    for (int o = 0; o < _VeilOctaves; o++)
    {
        int2 cells = baseCells << o;
        sum += weight * GradientNoise(uv * cells, cells, seed + o);
        weightSum += weight;
        weight *= 0.5;
    }
    return saturate(0.5 + 0.5 * (sum / weightSum) / 0.707);
}

int2 _PerlinResolution;
uint _PerlinSeed;
float _PerlinWeight;

[numthreads(8,8,1)]
void WriteGradients(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int2 id = dispatchThreadID.xy;
    if (any(id >= _PerlinResolution)) return;
    
    float random = pcg(id.x + pcg(id.y + _PerlinSeed)) / 4294967295.0 * 2 * PI;
    float s, c;
    sincos(random, s, c);
    _GradientWrite[id] = float2(c,s);
}

[numthreads(8,8,1)]
void AccumulatePerlin(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int2 id = dispatchThreadID.xy;
    if (any(id >= _Resolution)) return;

    float2 uv = (id + 0.5) / float2(_Resolution);
    float2 p = uv * _PerlinResolution;
    int2 i = (int2)floor(p);
    int2 i1 = (i + 1) % _PerlinResolution;
    float2 f = frac(p);

    float n00 = dot(_GradientRead[i], f - float2(0, 0));
    float n10 = dot(_GradientRead[int2(i1.x, i.y)], f - float2(1, 0));
    float n01 = dot(_GradientRead[int2(i.x, i1.y)], f - float2(0, 1));
    float n11 = dot(_GradientRead[i1], f - float2(1, 1));

    float2 s = f * f * f * (f * (f * 6 - 15) + 10);
    float n = lerp(lerp(n00, n10, s.x), lerp(n01, n11, s.x), s.y);

    _CloudWrite[id] = _CloudRead[id] + float2(n * _PerlinWeight, 0);
}

// 雲の高さ（R）を、今の範囲 [_HeightSrcMin, _HeightSrcMax] から [_HeightMin, _HeightMax] に引き伸ばす（初期化のときだけ）
float _HeightSrcMin;
float _HeightSrcMax;
float _HeightMin;
float _HeightMax;

[numthreads(8,8,1)]
void RemapHeight(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int2 id = dispatchThreadID.xy;
    if (any(id >= _Resolution)) return;

    float2 cloud = _CloudRead[id];
    float t = (cloud.x - _HeightSrcMin) / (_HeightSrcMax - _HeightSrcMin);
    _CloudWrite[id] = float2(lerp(_HeightMin, _HeightMax, t), cloud.y);
}

[numthreads(8,8,1)]
void InitializeCloud(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    
    
}

[numthreads(8,8,1)]
void InitializeVeil(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;

    float2 uv = (id + 0.5) / float2(_Resolution);

    // ドメインワープ: ノイズの位置を、別のノイズでずらす。糸が絡まったような、煙の形になる
    float2 warp = (float2(VeilFbm(uv, _VeilSeed), VeilFbm(uv, _VeilSeed + 100)) - 0.5) * _VeilWarp;
    float f = VeilFbm(uv + warp, _VeilSeed + 200);

    // _VeilCutoff より低い所は塵なし。残りを 0〜_VeilScale に引き伸ばす
    _VeilWrite[id] = _VeilScale * saturate((f - _VeilCutoff) / (1 - _VeilCutoff));
}

[numthreads(8,8,1)]
void AdvectCloud(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
     
    float2 uv = (id + 0.5) / float2(_Resolution);
    float2 velocity = _VelocityRead.SampleLevel(linearRepeatSampler, uv, 0) * DepthSpeed(_CloudRead[id].x);
    _CloudWrite[id] = _CloudRead.SampleLevel(linearRepeatSampler, uv - velocity * _DeltaTime, 0);
}

[numthreads(8,8,1)]
void AdvectVeil(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    
    float2 uv = (id + 0.5) / float2(_Resolution);
    float2 velocity = _VelocityRead.SampleLevel(linearRepeatSampler, uv, 0) * DepthSpeed(_VeilHeight);
    _VeilWrite[id] = _VeilRead.SampleLevel(linearRepeatSampler, uv - velocity * _DeltaTime, 0);
}

[numthreads(64,1,1)]
void SweepHorizon(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _AngleCount || id.y >= _StarCount) return;
    float angle = _AngleStep * id.x;
    float s, c;
    sincos(angle, s, c);
    float maxSlope = 0;
    float maxDensity = 0; // maxSlope を作った点（遮っている稜線）の密度。n_max
    StarData star = _StarRead[id.y];
    for (uint i = 0; i < _RadiusCount; i++)
    {
        float r = _RadiusStep * (i + 0.5);
        float2 uv = star.Position.xy + float2(r * c / _Aspect, r * s);
        float2 cloud = _CloudRead.SampleLevel(linearRepeatSampler, uv, 0);
        float n = cloud.y;

        // 光源 k から見た高さ: 読んだ位置の、光源からの最短距離 r' でお椀の分だけ上げる
        // （光線上の距離 r ではなく r' を使うのは、IlluminateCloud が同じ点で測る距離と揃えるため）
        float distanceToStar = length(WrapDelta(float2(r * c, r * s)));
        float h = cloud.x + BowlRise(distanceToStar);

        // 光源の高さ以上の面は、分母が _HDiffMin になり、slope が非常に大きい（その後ろを遮る壁）
        float slope = r / max(star.Position.z - h, _HDiffMin);

        // R: EUV が届くか（1 = 照らされる、0 = 影）
        float lit = slope > maxSlope ? 1 : 0;

        // G: dustPath（可視光が、遮る稜線の中を通った塵の量）の近似 = 影の深さ × 稜線の密度
        // 影の深さ = 稜線をかすめる光線の、この距離での高さ - この点の面の高さ（照らされる所では負なので 0 になる）
        float dustPath = 0;
        if (maxSlope > 0)
        {
            float rayHeight = star.Position.z - r / maxSlope;
            dustPath = maxDensity * max(rayHeight - h, 0);
        }
        _ShadowMapWrite[uint3(id.x, i, id.y)] = float2(lit, dustPath);

        // 面なしの点は遮らない
        if (n <= _MinN) continue;
        if (slope > maxSlope)
        {
            maxSlope = slope;
            maxDensity = n;
        }
    }
}

// 可視光の透過率（RGB）。dustPath が大きいほど暗くなり、係数が大きい青から先に減るので、残った光は赤くなる
float3 Transmittance(float dustPath)
{
    return exp(-_OpticalExtinction * dustPath);
}

// 塵が光を散らす向きの割合（Henyey-Greenstein の位相関数）
// mu = 光の進む向きと、散らされた光の向きのなす角の cos（1 = 前へ、-1 = 来た向きへはね返る）
float PhaseHG(float mu)
{
    float g2 = _HgG * _HgG;
    return (1 - g2) / (4 * PI * pow(1 + g2 - 2 * _HgG * mu, 1.5));
}

// 光源 k の光が、点にどれだけ届くか。toStarXY は点から光源への差（V座標系、WrapDelta 後）
// 戻り値 = (EUV が届くか, dustPath)
float2 StarReach(uint k, float2 toStarXY)
{
    float theta = atan2(-toStarXY.y, -toStarXY.x); // 光源から点への向き
    float2 shadowMapUv = float2((theta + 0.5 * _AngleStep) / (2 * PI), length(toStarXY) / _MaxRadius);
    return _ShadowMapRead.SampleLevel(linear_repeatU_clampV_sampler, float3(shadowMapUv, k), 0);
}

[numthreads(8,8,1)]
void IlluminateCloud(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    
    float2 uv = (id + 0.5) / float2(_Resolution);
    float2 cloud = _CloudRead.SampleLevel(linearRepeatSampler, uv, 0);
    if (!(cloud.y >= _MinN))
    {
        _FluxWrite[id] = 0;
        _ReflectionWrite[id] = 0;
        return;
    }
    float2 gradient = HeightGradient(id);
    float flux = 0;
    float3 reflection = 0;
    for (uint i = 0; i < _StarCount; i++)
    {
        StarData star = _StarRead[i];
        // この点から光源への差（V座標系。画面の端でつなげた最短の向き）と、その距離
        float2 toStarXY = WrapDelta((star.Position.xy - uv) * float2(_Aspect, 1));
        float r = length(toStarXY);

        // 光源 k から見た面: 高さをお椀の分だけ上げ、勾配もお椀の分だけ補正する
        // お椀の勾配は、光源から遠ざかる向きに増える。点から光源への差 toStarXY は逆向きなので、引く
        float hBowl = cloud.x + BowlRise(r);
        float2 gradientBowl = gradient - 2 * _BowlDepth * toStarXY / (_MaxRadius * _MaxRadius);
        float3 normalBowl = NormalFromGradient(gradientBowl);

        float3 toStar = float3(toStarXY, star.Position.z - hBowl);
        float toStarDist = max(length(toStar), _MinDist);
        float3 toStarDir = normalize(toStar);

        // 距離の2乗と入射角で薄まった分。EUV と可視光で共通
        float baseAmount = max(0, dot(normalBowl, toStarDir)) / (4 * PI * toStarDist * toStarDist);

        float2 reach = StarReach(i, toStarXY);
        float shadow = reach.x;   // EUV が届くか
        float dustPath = reach.y; // 可視光が通った塵の量

        flux += star.Euv * baseAmount * max(shadow, _ShadowFill);

        // 反射光: 光は光源からこの点へ向き (-toStarDir) で進み、真上（h が増える向き）の観測者へ散らされる
        // 2つの向きのなす角の cos は -toStarDir.z。影の中は Transmittance で暗く赤くなる
        reflection += star.Optical * baseAmount * PhaseHG(-toStarDir.z) * Transmittance(dustPath);
    }
    // 塵（密度）が多いほど反射するが、ある程度で頭打ちになる
    reflection *= _ReflectionScale * _StarlightColor.rgb * (1 - exp(-cloud.y / _NReflect));

    _FluxWrite[id] = flux;
    _ReflectionWrite[id] = float4(reflection, 1);
}

[numthreads(8,8,1)]
void IlluminateVeil(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;

    float2 uv = (id + 0.5) / float2(_Resolution);
    float n = _VeilRead[id];

    float3 light = 0;
    for (int i = 0; i < _StarCount; i++)
    {
        StarData star = _StarRead[i];
        float2 toStarXY = WrapDelta((star.Position.xy - uv) * float2(_Aspect, 1));
        float heightDiff = _VeilHeight - star.Position.z; // 光源は塵より奥にある
        float dist = max(length(float3(toStarXY, heightDiff)), _MinDist);

        // 光は光源からこの点へ進み、真上の観測者へ散らされる。進む向きの上向き成分が heightDiff / dist なので、
        // それが前方散乱の角の cos。光源が真下に近いほど前へ散る（逆光）
        float mu = heightDiff / dist;
        float baseAmount = 1 / (4 * PI * dist * dist);

        // 光源の方へ _VeilLightLength だけ進みながら、途中の塵の量（密度 × 長さ）を足す
        // 多いほど、この点に届く光が減る。塵が自分の影を落とすので、光源側の縁だけが明るくなる
        float2 stepXY = toStarXY / max(length(toStarXY), 1e-4) * (_VeilLightLength / _VeilLightTaps);
        float dust = 0;
        for (int t = 0; t < _VeilLightTaps; t++)
        {
            float2 uvT = uv + stepXY * (t + 0.5) / float2(_Aspect, 1);
            dust += _VeilRead.SampleLevel(linearRepeatSampler, uvT, 0);
        }
        dust *= _VeilLightLength / _VeilLightTaps;
        float reach = exp(-_VeilLightExtinction * dust);

        light += star.Optical * baseAmount * PhaseHG(mu) * reach;
    }

    // 塵が多いほど散らすが、ある程度で頭打ちになる（薄い所は光らない）
    float scatter = 1 - exp(-n / _VeilScatterN);
    _VeilLightWrite[id] = float4(light * scatter * _VeilGlowScale * _StarlightColor.rgb, 1);
}

#define STAR_MAX_RADIUS 4.0 // 明るさ 1 の星の半径（ピクセル）
#define SPIKE_MAX_LENGTH 30.0 // 明るさ 1 の星の回折スパイクの長さ（ピクセル）
#define SPIKE_GAIN 0.2 // スパイクの根元の明るさ（星の明るさに対する倍率）
// StarField: 1スレッド = 1個の星。星の番号から位置・明るさ・色を決めて、1ピクセルに書く
[numthreads(8,8,1)]
void BakeStarField(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint i = dispatchThreadID.x;
    if (dispatchThreadID.y != 0 || i >= (uint)_StarFieldCount) return;

    uint h0 = pcg(i);
    uint h1 = pcg(h0);
    uint h2 = pcg(h1);

    uint2 pixel = uint2(h0 % (uint)_Resolution.x, h1 % (uint)_Resolution.y);
    float brightness = pow(h2 / 4294967295.0, 3.0); // 暗い星が多く、明るい星が少ない
    float temperature = brightness;                 // 明るい星ほど青白い（0 = 赤っぽい, 1 = 青白い）
    float3 tint = lerp(float3(1.0, 0.8, 0.65), float3(0.7, 0.8, 1.0), temperature);

    // 回折スパイク: 縦と、そこから ±60° の 3本の直線を、星から両向きに伸ばして 6本にする。
    // 長さは明るさの2乗に比例（暗い星は短くて目立たない）。根元から先へ (1 - t)^2 で薄くなる
    // 星の本体より先に書く。あとで本体の円が根元を上書きする
    float spikeLength = brightness * brightness * SPIKE_MAX_LENGTH;
    for (int lineIndex = 0; lineIndex < 3; lineIndex++)
    {
        float angle = PI * 0.5 + lineIndex * PI / 3.0; // 90°, 150°, 210°（210° は 30° の反対向き。両向きに描くので 3本で 6方向）
        float2 dir = float2(cos(angle), sin(angle));
        for (int stepIndex = 1; stepIndex <= (int)ceil(spikeLength); stepIndex++)
        {
            float t = stepIndex / spikeLength;
            if (t > 1.0) break;
            float3 spikeColor = tint * brightness * SPIKE_GAIN * (1.0 - t) * (1.0 - t);
            for (int side = -1; side <= 1; side += 2)
            {
                int2 sp = (int2)pixel + (int2)round(dir * stepIndex * side);
                if (sp.x < 0 || sp.y < 0 || sp.x >= _Resolution.x || sp.y >= _Resolution.y) continue;
                _StarFieldWrite[sp] = float4(spikeColor, 1);
            }
        }
    }

    // 明るさ 0.9〜1 の星は、明るさに比例して大きくする（0.9 で半径 0 = 1ピクセル、1 で半径 STAR_MAX_RADIUS ピクセル）
    float radius = saturate((brightness - 0.9) / 0.1) * STAR_MAX_RADIUS;
    int r = (int)ceil(radius);
    for (int dy = -r; dy <= r; dy++)
    {
        for (int dx = -r; dx <= r; dx++)
        {
            if (dx * dx + dy * dy > radius * radius) continue;
            int2 p = (int2)pixel + int2(dx, dy);
            if (p.x < 0 || p.y < 0 || p.x >= _Resolution.x || p.y >= _Resolution.y) continue;
            _StarFieldWrite[p] = float4(tint * brightness, 1);
        }
    }
}

[numthreads(8,8,1)]
void Compose(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;

    float2 uv = (id + 0.5) / float2(_Resolution);
    float n = _CloudRead[id].y;
    float fogFlux = FogFlux(uv);

    // 一番奥の星空の上に、層 + 霧（水素の色）+ [O III] + 反射光 を重ね、手前の塵で吸収し、塵の散乱光を足す
    float3 color = _StarFieldRead[id].rgb;
    color += Layers(id);
    color += _HaColor.rgb * _FogScale * fogFlux;
    color += OIII(fogFlux, n);
    color += _ReflectionRead[id].rgb;

    // 魚: 雲の手前にいるので、雲の色を魚の色で置き換える。Veil はその手前にあるので、
    // このあとの吸収と散乱光が、魚にもかかる（魚が煙の向こうに見える）
    // fish.rgb は A を掛けた色（MSAA で縁が平均されるとそうなる）なので、雲の色は (1 - A) だけ残して足す
    float4 fish = _FishRead[id];
    color = color * (1 - fish.a) + fish.rgb;

    // 手前の塵の吸収: 画面全体に薄く広がる塵 + 筋や塊の塵。青から先に削られて、赤茶〜黒になる
    float veilN = _VeilRead[id];
    color *= exp(-_VeilExtinction * (_VeilFloor + veilN));

    // 手前の塵が星の光を散らして光る分。塵自身が出す光なので、吸収のあとに足す
    color += _VeilLightRead[id].rgb;
    _NebulaWrite[id] = float4(color, 1);
}

[numthreads(8,8,1)]
void DebugView(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;

    float3 color = 0;
    float rangeWidth = _DebugRange.y - _DebugRange.x;

    if (_DebugMode == DEBUG_HEIGHT)
    {
        // 高さ h を _DebugRange で 0〜1 に伸ばして、グレーで見る
        float h = _CloudRead[id].x;
        color = saturate((h - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_DENSITY)
    {
        // 密度 n を同じように見る。面なし（n が _MinN 未満）は暗い青
        float n = _CloudRead[id].y;
        color = n >= _MinN ? saturate((n - _DebugRange.x) / rangeWidth) : float3(0, 0, 0.2);
    }
    else if (_DebugMode == DEBUG_NORMAL)
    {
        // -1〜1 を 0〜1 に直して、N.x, N.y, N.h を R, G, B に
        color = SurfaceNormal(id) * 0.5 + 0.5;
    }
    else if (_DebugMode == DEBUG_FLUX)
    {
        // flux は桁が大きく変わるので log10 で見る。_DebugRange は log10 の値
        float flux = _FluxRead[id];
        color = saturate((log10(max(flux, 1e-6)) - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_LAYERS)
    {
        color = saturate((Layers(id) - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_FOGFLUX)
    {
        float2 uv = (id + 0.5) / float2(_Resolution);
        color = saturate((log10(max(FogFlux(uv), 1e-6)) - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_IONIZATION)
    {
        float2 uv = (id + 0.5) / float2(_Resolution);
        float u = IonizationParameter(FogFlux(uv), _CloudRead[id].y);
        color = saturate((log10(max(u, 1e-6)) - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_DUST_PATH)
    {
        // 光源 0 の dustPath を画面の位置で見る（影の奥ほど明るい）
        float2 uv = (id + 0.5) / float2(_Resolution);
        float2 toStarXY = WrapDelta((_StarRead[0].Position.xy - uv) * float2(_Aspect, 1));
        color = saturate((StarReach(0, toStarXY).y - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_REFLECTION)
    {
        // 反射光（RGB）を _DebugRange で 0〜1 に伸ばして見る
        color = saturate((_ReflectionRead[id].rgb - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_VEIL)
    {
        // 手前の塵の密度 n を、グレーで見る
        color = saturate((_VeilRead[id] - _DebugRange.x) / rangeWidth);
    }
    else if (_DebugMode == DEBUG_VEIL_LIGHT)
    {
        // 手前の塵の散乱光（RGB）を見る
        color = saturate((_VeilLightRead[id].rgb - _DebugRange.x) / rangeWidth);
    }

    _NebulaWrite[id] = float4(color, 1);
}