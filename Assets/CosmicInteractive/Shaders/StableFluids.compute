#pragma kernel AddVelocity
#pragma kernel AdvectVelocity
#pragma kernel Divergence
#pragma kernel PressureJacobi
#pragma kernel SubtractPressureGradient

struct InputData
{
    float2 position;
    float2 velocity;
    float radius;
};

// Buffer
StructuredBuffer<InputData> _InputBufferRead;

Texture2D<float2> _VelocityFieldRead;
RWTexture2D<float2> _VelocityFieldWrite;

Texture2D<float> _DivergenceBufferRead;
RWTexture2D<float> _DivergenceBufferWrite;

Texture2D<float> _PressureBufferRead;
RWTexture2D<float> _PressureBufferWrite;

// Common
uint2 _Resolution;
float _Aspect;
float _DeltaTime;

// AddVelocity(Input)
uint _InputCount;
uint _MaxInputs;
float _VelocityBlendFactor;

// AdvectVelocity
SamplerState linearRepeatSampler;

uint2 modIndex(int2 index)
{
    int2 res = (int2)_Resolution;
    return (uint2)((index % res + res) % res);
}

float2 texcel2Uv(float2 id) { return (id + 0.5) / (float2)_Resolution; }

[numthreads(8,8,1)]
void AddVelocity(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    
    float2 uv = texcel2Uv(id);
    float2 prev = _VelocityFieldRead[id];
    float2 velocity = _VelocityFieldRead[id];

    for (int i = 0; i < min(_InputCount, _MaxInputs); i++)
    {
        InputData d = _InputBufferRead[i];
        float2 toInput = (d.position - uv) * float2(_Aspect, 1);
        float weight = exp(-dot(toInput, toInput) / (d.radius * d.radius));
        velocity += d.velocity * weight;
    }
    _VelocityFieldWrite[id] = lerp(prev, velocity, _VelocityBlendFactor);
}

[numthreads(8,8,1)]
void AdvectVelocity(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    float2 uv = texcel2Uv(id) - _VelocityFieldRead[id] * _DeltaTime;
    _VelocityFieldWrite[id] = _VelocityFieldRead.SampleLevel(linearRepeatSampler, uv, 0);
}

[numthreads(8,8,1)]
void Divergence(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = (int2)dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    float xIn = _VelocityFieldRead[modIndex(id + int2(-1,0))].x;
    float xOut = _VelocityFieldRead[modIndex(id + int2(1,0))].x;
    float yIn = _VelocityFieldRead[modIndex(id + int2(0,-1))].y;
    float yOut = _VelocityFieldRead[modIndex(id + int2(0,1))].y;
    _DivergenceBufferWrite[id] = ((xOut - xIn) * _Resolution.x + (yOut - yIn) * _Resolution.y) * 0.5;
}

[numthreads(8,8,1)]
void PressureJacobi(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = (int2)dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    float pLeft = _PressureBufferRead[modIndex(id + int2(-1,0))];
    float pRight = _PressureBufferRead[modIndex(id + int2(1,0))];
    float pDown = _PressureBufferRead[modIndex(id + int2(0,-1))];
    float pUp = _PressureBufferRead[modIndex(id + int2(0,1))];
    float divergence = _DivergenceBufferRead[id];
    _PressureBufferWrite[id] = (pLeft + pRight + pDown + pUp - divergence) * 0.25;
}

[numthreads(8,8,1)]
void SubtractPressureGradient(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = (int2)dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    float pLeft = _PressureBufferRead[modIndex(id + int2(-1,0))];
    float pRight = _PressureBufferRead[modIndex(id + int2(1,0))];
    float pDown = _PressureBufferRead[modIndex(id + int2(0,-1))];
    float pUp = _PressureBufferRead[modIndex(id + int2(0,1))];
    float2 velocity = _VelocityFieldRead[id];
    _VelocityFieldWrite[id] = velocity + 0.5 * float2(pLeft - pRight, pDown - pUp) / _Resolution;
}