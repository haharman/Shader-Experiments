#pragma kernel AdvectDye

// Buffer
Texture2D<float2> _VelocityFieldRead;
Texture2D<float4> _DyeTextureRead;
RWTexture2D<float4> _DyeTextureWrite;

// Common
uint2 _Resolution;
float _DeltaTime;

// AdvectDye
SamplerState linearRepeatSampler;

[numthreads(8,8,1)]
void AdvectDye(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 id = dispatchThreadID.xy;
    if (id.x >= _Resolution.x || id.y >= _Resolution.y) return;
    
    float2 uv = (id + 0.5) / float2(_Resolution);
    float2 velocity = _VelocityFieldRead.SampleLevel(linearRepeatSampler, uv, 0);
    _DyeTextureWrite[id] = _DyeTextureRead.SampleLevel(linearRepeatSampler, uv - velocity * _DeltaTime, 0);
}